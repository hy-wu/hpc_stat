---
import Base from "../layouts/Base.astro";
import InsightGrid from "../components/workbench/InsightGrid.astro";
import TablePanel from "../components/workbench/TablePanel.astro";
---

<Base title="Model × Hardware Matrix" active="model-hardware">
  <div class="filter-card">
    <section class="control-band">
      <div class="search-block">
        <label for="globalSearch">搜索矩阵</label>
        <input id="globalSearch" type="search" placeholder="模型、硬件、部署方式、精度、吞吐、成本、评价..." />
      </div>
      <div class="control">
        <label for="gpuFilter">聚焦硬件</label>
        <select id="gpuFilter"></select>
      </div>
      <div class="control">
        <label for="modelVendorFilter">模型厂商</label>
        <select id="modelVendorFilter"></select>
      </div>
      <div class="control">
        <label for="deployModeFilter">部署方式</label>
        <select id="deployModeFilter"></select>
      </div>
      <div class="control">
        <label for="precisionFilter">量化精度</label>
        <select id="precisionFilter"></select>
      </div>
      <div class="control">
        <label for="sortField">模型行排序</label>
        <select id="sortField"></select>
      </div>
      <button class="ghost-button" id="sortDirectionButton" type="button">降序</button>
      <button class="ghost-button" id="resetFiltersButton" type="button">重置</button>
    </section>
    <section class="filters-panel-inner">
      <div class="panel-head">
        <h2>组合筛选</h2>
        <button class="text-button" id="addRuleButton" type="button">添加条件</button>
      </div>
      <div id="filterRules" class="rules"></div>
    </section>
  </div>

  <InsightGrid metrics={[
    { id: "visibleCount", label: "筛选组合" },
    { id: "singleCardCount", label: "单卡/单设备可部署" },
    { id: "multiCardCount", label: "多卡/集群" },
    { id: "avgFitScore", label: "平均硬件适配" },
  ]} />

  <TablePanel title="模型 × 硬件矩阵">
    <p slot="legend" class="matrix-legend muted">
      单元格说明：适配条 <strong>M</strong>=显存容量 · <strong>B</strong>=带宽 · <strong>C</strong>=算力（1–5 人工适配度，非 benchmark）；
      背景柱状图三根竖条依次为 <strong>↑输入(prefill)</strong>、<strong>↓输出(decode)</strong> 速度(tok/s) 与并发数，柱高按全表全局最大值归一（筛选时标尺不变），颜色越深数值越高，悬停单元格可见具体数值与口径；
      速度数据摘自博客/论坛/新闻等公开实测；筛选后无任何记录的硬件列会自动隐藏。
    </p>
  </TablePanel>

  <div data-matrix-page="model-hardware"></div>
  <script>
    import "../islands/MatrixTable";
  </script>
</Base>
